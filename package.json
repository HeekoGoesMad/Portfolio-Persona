{
  "name": "persona-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check && node scripts/validate-content.mjs",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "audit:site": "node scripts/audit-site.mjs",
    "test:unit": "node --experimental-strip-types --test tests-unit/*.test.ts"
  },
  "dependencies": {
    "@astrojs/react": "7.1.0",
    "@fontsource/barlow-condensed": "5.3.0",
