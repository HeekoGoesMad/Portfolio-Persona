    "@sanity/client": "8.9.0",
    "@sanity/icons": "5.2.3",
    "astro": "7.4.0",
    "astro-portabletext": "1.0.1",
    "groq": "6.19.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "sanity": "6.19.0",
    "styled-components": "6.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
