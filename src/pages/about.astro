---
import Layout from '../layouts/Layout.astro';
import { profile } from '../data/profile';
import { persona } from '../data/persona';
import { withBase } from '../lib/paths';
const portraitSrcset = `${withBase('/persona/protagonist-768.webp')} 768w, ${withBase('/persona/protagonist-1280.webp')} 1280w`;
---
<Layout title="About" section="Profile">
  <section class="about-page page-width">
    <div class="page-heading" data-enter><p class="eyebrow" data-cms-setting="aboutEyebrow">The person behind the projects</p><h1>A LITTLE<br /><span>ABOUT ME.</span></h1></div>
    <div class="about-grid">
      <div class="about-left-col">
        <div class="profile-art" aria-hidden="true"><img src={withBase(persona.portrait)} srcset={portraitSrcset} sizes="(max-width:767px) 90vw,42vw" alt="" width="800" height="880" data-cms-profile="portrait" /></div>
        <dl class="dossier-telemetry" aria-label="Operational telemetry summary">
          <div class="dossier-stat">
            <dt>SHIPPED SYSTEMS</dt>
            <dd>03 Case Studies</dd>
          </div>
          <div class="dossier-stat">
            <dt>CORE STACKS</dt>
            <dd>Flutter · Kotlin · Next.js</dd>
          </div>
          <div class="dossier-stat">
            <dt>QUALITY GATE</dt>
            <dd>WCAG 2.1 AA + E2E</dd>
          </div>
          <div class="dossier-stat">
            <dt>AVAILABILITY</dt>
            <dd>Open to Roles &amp; Collab</dd>
          </div>
        </dl>
      </div>
      <div class="about-copy">
        <p class="eyebrow" data-cms-profile="role">{profile.role}</p>
        <h2 data-cms-profile="name">{profile.name}</h2>
        <p class="large-copy" data-cms-profile="introduction">{profile.introduction}</p>
        <p data-cms-profile="biography">{profile.biography}</p>
        {profile.example && <p class="inline-notice">Example profile. Replace this introduction, biography, and skills with your real background.</p>}
        <h3>Technical Proficiencies by Domain</h3>
        <div class="skill-domains">
          {profile.skillGroups.map(group => (
            <div class="skill-domain-card">
              <h4>{group.domain}</h4>
              <ul class="skills-list">
                {group.items.map(s => <li>{s}</li>)}
              </ul>
            </div>
          ))}
        </div>
        <div class="about-actions">
          {profile.resume && <a class="action-link" href={withBase(profile.resume)} data-cms-profile="resume" download="Adrienne-Lie-Resume.pdf">Download Résumé PDF ↗</a>}
          <a class="text-link" href={withBase('/contact/')}>Get in touch ↗</a>
        </div>
      </div>
    </div>
    <div class="artbook-section">
      <div class="artbook-heading">
        <p class="eyebrow">P3R ARTBOOK ARCHIVE // OFFICIAL CONCEPT ART</p>
        <h2>CONCEPT <span>GALLERY.</span></h2>
      </div>
      <div class="artbook-grid">
        {persona.artbook.map((item)=>(
          <figure class="artbook-card">
            <div class="artbook-frame">
              <img src={withBase(item.src)} alt={`${item.title} concept art from Persona 3 Reload Artbook`} width="728" height="514" loading="lazy" />
              <span class="artbook-tag">PAGE {item.page}</span>
            </div>
            <figcaption>
              <strong>{item.title}</strong>
              <small>{item.role}</small>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
</Layout>
