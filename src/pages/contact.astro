---
import Layout from '../layouts/Layout.astro';
import { profile } from '../data/profile';
import { withBase } from '../lib/paths';
---
<Layout title="Contact" section="Contact">
  <section class="contact-page page-width" data-enter><div class="page-heading"><p class="eyebrow">Good things start with a conversation</p><h1>HAVE SOMETHING<br /><span>IN MIND?</span></h1></div><div class="contact-grid"><p class="large-copy">A project, an opportunity, or an idea worth exploring. Let's talk.</p><div class="contact-details">{profile.email ? <a class="contact-email" href={`mailto:${profile.email}`}>{profile.email}<span aria-hidden="true">↗</span></a> : <div class="contact-placeholder"><h2>CONTACT DETAILS<br />COMING SOON.</h2><p>This editable portfolio is ready for your email and professional links.</p></div>}{profile.socials.length>0 && <ul class="social-links">{profile.socials.map(s=><li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.label} ↗</a></li>)}</ul>}<a class="text-link" href={withBase('/projects/')}>Explore the projects ↗</a></div></div></section>
</Layout>
