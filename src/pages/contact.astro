---
import Layout from '../layouts/Layout.astro';
import { profile } from '../data/profile';
import { withBase } from '../lib/paths';
const contactEndpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT || '';
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
---
<Layout title="Contact" section="Contact">
  <section class="contact-page page-width" data-enter>
    <div class="page-heading">
      <p class="eyebrow" data-cms-setting="contactEyebrow">Good things start with a conversation</p>
      <h1>HAVE SOMETHING<br /><span>IN MIND?</span></h1>
    </div>
    <div class="contact-grid">
      <div class="contact-intro-col">
        <p class="large-copy">A project, an opportunity, or an idea worth exploring. Let's talk.</p>
        <div class="contact-details">
          {profile.email ? (
            <a class="contact-email" href={`mailto:${profile.email}`} data-cms-profile="email">
              <span data-cms-email-text>{profile.email}</span>
              <span aria-hidden="true">↗</span>
            </a>
          ) : (
            <div class="contact-placeholder">
              <h2>CONTACT DETAILS<br />COMING SOON.</h2>
              <p>This editable portfolio is ready for your email and professional links.</p>
            </div>
          )}
          {profile.socials.length > 0 && (
            <ul class="social-links">
              {profile.socials.map(s => (
                <li><a href={s.url} target={s.url.startsWith('http') ? '_blank' : undefined} rel={s.url.startsWith('http') ? 'noopener noreferrer' : undefined} class="social-pill">{s.label} ↗</a></li>
              ))}
            </ul>
          )}
          {profile.resume && (
            <p><a class="text-link" href={withBase(profile.resume)} data-cms-profile="resume" download="Adrienne-Lie-Resume.pdf">Download Résumé PDF ↗</a></p>
          )}
          <a class="text-link" href={withBase('/projects/')}>Explore the projects ↗</a>
        </div>
      </div>

      <form class="contact-form" data-contact-form data-contact-endpoint={contactEndpoint} data-recipient={profile.email} action={`mailto:${profile.email}`} method="post" enctype="text/plain">
        <h2>SEND DISPATCH</h2>
        <div class="form-honeypot" aria-hidden="true">
          <label for="bot-gotcha">Do not fill this field if you are human</label>
          <input id="bot-gotcha" type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
        </div>
        <div class="form-field">
          <label for="contact-name">Your Name</label>
          <input id="contact-name" name="name" type="text" required autocomplete="name" placeholder="Makoto Yuki" />
        </div>
        <div class="form-field">
          <label for="contact-email-input">Your Email</label>
          <input id="contact-email-input" name="email" type="email" required autocomplete="email" placeholder="you@example.com" />
        </div>
        <div class="form-field">
          <label for="contact-topic">Inquiry Topic</label>
          <select id="contact-topic" name="subject">
            <option value="Project Collaboration">Project Collaboration</option>
            <option value="Full-Time / Engineering Role">Full-Time / Engineering Role</option>
            <option value="Mobile & Flutter / Kotlin Consulting">Mobile &amp; Flutter / Kotlin Consulting</option>
            <option value="General Hello">General Hello</option>
          </select>
        </div>
        <div class="form-field">
          <label for="contact-message">Message</label>
          <textarea id="contact-message" name="message" rows="4" required placeholder="Tell me about your timeline, goals, or technical challenge..."></textarea>
        </div>
        {turnstileSiteKey && (
          <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="dark"></div>
        )}
        <div class="form-actions">
          <button type="submit" class="action-link contact-submit-btn">Send Message <span aria-hidden="true">↗</span></button>
          <span class="spam-shield-badge" title="Protected by Honeypot + Turnstile anti-spam filter">✓ Spam Protected</span>
        </div>
        <p class="form-status" data-contact-status role="status" aria-live="polite" hidden></p>
      </form>
    </div>
  </section>
  {turnstileSiteKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <script>
    function setupContactForm() {
      const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
      const status = document.querySelector<HTMLElement>('[data-contact-status]');
      if (!form || form.dataset.bound) return;
      form.dataset.bound = 'true';
      let lastSubmit = 0;

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const data = new FormData(form);
        // 1. Honeypot spam protection
        if (String(data.get('_gotcha') || '').trim().length > 0) {
          if (status) {
            status.hidden = false;
            status.textContent = 'Submission filtered by automated spam guard.';
          }
          return;
        }
        // 2. Client rate-limit guard
        const now = Date.now();
        if (now - lastSubmit < 4000) {
          if (status) {
            status.hidden = false;
            status.textContent = 'Please wait a moment before sending another message.';
          }
          return;
        }
        lastSubmit = now;

        const name = String(data.get('name') || '').trim();
        const email = String(data.get('email') || '').trim();
        const subject = String(data.get('subject') || 'Portfolio Inquiry').trim();
        const message = String(data.get('message') || '').trim();
        const endpoint = form.dataset.contactEndpoint || '';
        const recipient = form.dataset.recipient || 'adriennelie190505@gmail.com';

        if (endpoint) {
          try {
            if (status) { status.hidden = false; status.textContent = 'Transmitting dispatch...'; }
            const response = await fetch(endpoint, {
              method: 'POST',
              headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' },
              body: JSON.stringify({ name, email, subject, message }),
            });
            if (response.ok) {
              if (status) {
                status.hidden = false;
                status.textContent = `Dispatch received! Thank you, ${name}. I will reply to ${email} shortly.`;
              }
              form.reset();
              return;
            }
          } catch {
            /* Fall back to mailto + local outbox below */
          }
        }

        // Save to local outbox log and prepare instant mailto link
        const mailtoHref = `mailto:${recipient}?subject=${encodeURIComponent(`[Portfolio] ${subject} — from ${name}`)}&body=${encodeURIComponent(`From: ${name} (${email})\n\n${message}`)}`;
        if (status) {
          status.hidden = false;
          status.innerHTML = `Dispatch ready for <strong>${recipient}</strong>! <a href="${mailtoHref}" class="text-link">Click here if your mail client did not open automatically ↗</a>`;
        }
        if (!navigator.webdriver) {
          window.location.href = mailtoHref;
        }
        form.reset();
      });
    }
    document.addEventListener('astro:page-load', setupContactForm);
    setupContactForm();
  </script>
</Layout>
