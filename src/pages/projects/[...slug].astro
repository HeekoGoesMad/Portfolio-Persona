---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getProjects } from '../../lib/projects';
export async function getStaticPaths() {
  return (await getProjects()).map(project=>({params:{slug:project.id},props:{project}}));
}
const { project } = Astro.props;
const { Content, headings } = await render(project);
const { data }=project;
---
<Layout title={data.title} section="Case study" description={data.summary}>
  <article class="case-study page-width">
    <a class="text-link back-link" href="/projects/">← Back to projects</a>
    <header class="case-header" data-enter><div><p class="eyebrow">{data.category} {data.example && <span class="example-tag">Example project</span>}</p><h1>{data.title}</h1><p class="case-summary">{data.summary}</p></div><dl class="project-facts"><div><dt>Role</dt><dd>{data.role}</dd></div><div><dt>Built with</dt><dd>{data.technologies.join(', ')}</dd></div><div><dt>Year</dt><dd>{data.date.getFullYear()}</dd></div></dl></header>
    {data.example && <aside class="inline-notice">Illustrative case study. This concept demonstrates the portfolio structure; it does not claim a shipped product or measured results.</aside>}
    <figure class="case-cover"><img src={data.thumbnail || '/art/share.svg'} alt={data.thumbnailAlt || 'Project concept artwork'} width="1200" height="720" fetchpriority="high" /><figcaption>Original concept artwork{data.example?' for this example project':''}.</figcaption></figure>
    <div class="article-layout"><nav class="article-nav" aria-label="Case study sections"><p class="eyebrow">In this case study</p>{headings.filter(h=>h.depth===2).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}<div class="project-external-links">{data.demo && <a href={data.demo} target="_blank" rel="noopener noreferrer">Live project ↗</a>}{data.repository && <a href={data.repository} target="_blank" rel="noopener noreferrer">Source code ↗</a>}</div></nav><div class="prose"><Content /></div></div>
    <a class="action-link case-end" href="/projects/">Back to the collection <span aria-hidden="true">↗</span></a>
  </article>
</Layout>
