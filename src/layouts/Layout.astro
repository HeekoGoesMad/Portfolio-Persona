---
import { ClientRouter } from 'astro:transitions';
import '@fontsource/barlow-condensed/800-italic.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';
import '../styles/global.css';
import { profile } from '../data/profile';
interface Props { title: string; description?: string; section?: string; home?: boolean; }
const { title, description = profile.introduction, section='Portfolio', home=false } = Astro.props;
const path = Astro.url.pathname;
const configured = Astro.site && !['localhost','your-domain.example'].includes(Astro.site.hostname);
const canonical = configured ? new URL(path, Astro.site) : undefined;
const nav=[['Projects','/projects/'],['About','/about/'],['Contact','/contact/']];
---
<!doctype html>
<html lang="en" data-motion="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#0629ae" />
    <title>{title} | {profile.name}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={profile.example ? 'noindex, nofollow' : 'index, follow'} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={`${title} | ${profile.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={new URL('/art/share.svg', Astro.site).href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      try { if (localStorage.getItem('portfolio-motion') === 'reduce') document.documentElement.dataset.motion='reduce'; } catch {}
    </script>
    {section !== 'Lost signal' && <ClientRouter fallback="none" />}
  </head>
  <body class:list={[{ 'is-home': home }]}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Portfolio home"><span class="brand-symbol" aria-hidden="true">P/</span><span>PERSONAL<br /><strong>PORTFOLIO</strong></span></a>
      <nav class="desktop-nav" aria-label="Main navigation">
        {nav.map(([label,href])=><a href={href} aria-current={path.startsWith(href!) ? 'page' : undefined}>{label}</a>)}
        {profile.resume && <a href={profile.resume}>Résumé <span aria-hidden="true">↗</span></a>}
      </nav>
      <div class="header-controls">
        <button type="button" class="sound-button js-only" data-sound-toggle aria-pressed="false" aria-label="Sound: off"><span class="sound-bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span data-sound-label>SOUND OFF</span></button>
        <button type="button" class="settings-button js-only" data-settings-open>Settings <span aria-hidden="true">+</span></button>
        <button type="button" class="mobile-menu-button js-only" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu">Menu <span aria-hidden="true">+</span></button>
      </div>
      <nav id="mobile-menu" class="mobile-nav" aria-label="Mobile navigation" hidden>
        {nav.map(([label,href])=><a href={href} aria-current={path.startsWith(href!) ? 'page' : undefined}>{label}<span aria-hidden="true">↗</span></a>)}
        {profile.resume && <a href={profile.resume}>Résumé</a>}
        <button type="button" class="mobile-preferences" data-settings-open>Preferences <span aria-hidden="true">+</span></button>
      </nav>
      <noscript><nav class="noscript-nav" aria-label="Mobile navigation">{nav.map(([label,href])=><a href={href}>{label}</a>)}</nav></noscript>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <svg class="footer-title" viewBox="0 0 1600 230" preserveAspectRatio="xMinYMin meet" aria-hidden="true" focusable="false"><text x="0" y="205">{section}</text></svg>
      <div class="footer-content"><p>{profile.name}<span class="footer-divider">/</span>{profile.role}</p><div><span class="key-hint">{home || section==='Projects' ? <><kbd>↑</kbd><kbd>↓</kbd></> : <kbd>Tab</kbd>} Navigate <kbd>↵</kbd> Select</span><a href="#main">Back to top ↑</a></div></div>
      {profile.example && <p class="example-note">Editable example portfolio. Project concepts and profile content are illustrative.</p>}
    </footer>
    <dialog class="settings-dialog" aria-labelledby="settings-title">
      <div class="dialog-heading"><p class="eyebrow">Make yourself comfortable</p><button type="button" data-settings-close aria-label="Close settings">Close ×</button></div>
      <h2 id="settings-title">CONFIG</h2>
      <label class="setting-row"><span><strong>Interface sounds</strong><small>Short feedback when you select or confirm.</small></span><input type="checkbox" data-sound-input /><span class="toggle" aria-hidden="true"></span></label>
      <label class="setting-row"><span><strong>Reduce motion</strong><small>Your system preference is always respected.</small></span><input type="checkbox" data-motion-input /><span class="toggle" aria-hidden="true"></span></label>
      <p class="settings-note">Preferences stay in this browser. Audio starts only after you turn it on.</p>
    </dialog>
    <script>import '../scripts/site';</script>
  </body>
</html>
